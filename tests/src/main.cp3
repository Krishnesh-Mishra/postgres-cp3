// postgres package - async test suite orchestrator.
//
// Run from the tests/ directory:
//   cp3 run src/main.cp3
//
// Configuration (same as the previous single-file suite):
//   CP3_PG_HOST      (default 127.0.0.1)
//   CP3_PG_PORT      (default 55432)
//   CP3_PG_DB        (default cp3_test)
//   CP3_PG_USER      (default postgres)
//   CP3_PG_PASSWORD  (default empty)
// or a full libpq conninfo string in CP3_PG_CONNINFO, which wins.
//
// The suite is organized as a pipeline of stages, one module per stage,
// executed in order. Stages that need a live server open their own
// connections. A failing stage does not stop the pipeline.

import console from "std/console";
import process from "std/process";

import { conninfoStringOverride, clientConninfo, host, port, database, user } from "./support/env.cp3";
import { passCount, failureCount, fail } from "./support/harness.cp3";

import {
  connect,
  close,
} from "../../src/client.cp3";

import { run as build } from "./stages/build.cp3";
import { run as conninfoStage } from "./stages/conninfo.cp3";
import { run as connectStage } from "./stages/connect.cp3";
import { run as resultsStage } from "./stages/results.cp3";
import { run as paramsStage } from "./stages/params.cp3";
import { run as dmlStage } from "./stages/dml.cp3";
import { run as transactionsStage } from "./stages/transactions.cp3";
import { run as unicodeStage } from "./stages/unicode.cp3";
import { run as escapesStage } from "./stages/escapes.cp3";
import { run as handlesStage } from "./stages/handles.cp3";
import { run as poolStage } from "./stages/pool.cp3";
import { run as cancelStage } from "./stages/cancel.cp3";

export function printSummary(): undefined {
  console.log("");
  console.log("passed: " + passCount().toString());
  console.log("failed: " + failureCount().toString());
  if (failureCount() === 0) {
    console.log("RESULT: PASS");
  } else {
    console.log("RESULT: FAIL");
  }
  return undefined;
}

export async function runStage(name: string,
                               stage: () => Promise<undefined>): Promise<undefined> {
  try {
    await stage();
    return undefined;
  } catch (err) {
    fail(name, err.message);
    return undefined;
  }
}

async function main(): Promise<undefined> {
  console.log("postgres cp3 package - async test suite");
  console.log("server: " + host() + ":" + port().toString() +
              " db=" + database() + " user=" + user() +
              (conninfoStringOverride().length > 0 ? " (CP3_PG_CONNINFO)" : ""));

  // Stages that do not need a live server run first.
  await build();
  await conninfoStage();

  // Verify the server is reachable before running server-backed stages.
  const probe = await connect(clientConninfo());
  if (probe === 0) {
    fail("connect to the test server", "could not connect");
    printSummary();
    process.exit(1);
    return undefined;
  }
  close(probe);

  await runStage("connection lifecycle", connectStage);
  await runStage("SELECT and result metadata", resultsStage);
  await runStage("parameterized queries", paramsStage);
  await runStage("DDL and DML", dmlStage);
  await runStage("transactions", transactionsStage);
  await runStage("Unicode and larger values", unicodeStage);
  await runStage("escaping", escapesStage);
  await runStage("defensive handle behavior", handlesStage);
  await runStage("connection pool", poolStage);
  await runStage("cancellation", cancelStage);

  printSummary();
  process.exit(failureCount() === 0 ? 0 : 1);
  return undefined;
}

// main() always calls process.exit; nothing else handles the result.
main();
