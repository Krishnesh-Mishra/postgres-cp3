// env.cp3 - connection configuration for the test server, from the
// environment (same variables as the old single-file suite).
//
// CP3_PG_CONNINFO, if set, wins; otherwise the discrete fields are built
// into a libpq conninfo via the package's conninfo().

import { env } from "std/env";
import { conninfo } from "../../../src/conninfo.cp3";

export function host(): string {
  return env.get("CP3_PG_HOST", { default: "127.0.0.1" });
}

export function port(): number {
  return env.get("CP3_PG_PORT", { default: 55432 });
}

export function database(): string {
  return env.get("CP3_PG_DB", { default: "cp3_test" });
}

export function user(): string {
  return env.get("CP3_PG_USER", { default: "postgres" });
}

export function password(): string {
  return env.get("CP3_PG_PASSWORD", { default: "" });
}

// Raw CP3_PG_CONNINFO, if set (empty string otherwise).
export function conninfoStringOverride(): string {
  return env.get("CP3_PG_CONNINFO", { default: "" });
}

// The conninfo string used by the suite. A short connect timeout is
// always applied so test stages fail fast when no server is listening
// (the default is "wait forever", which would hang the whole suite).
export function clientConninfo(): string {
  const override = conninfoStringOverride();
  if (override !== "") {
    return override;
  }
  return conninfo(host(), port(), database(), user(), password()) +
         " connect_timeout=2";
}
