// postgres - an asynchronous PostgreSQL client for cp3, built on libpq.
//
//   import postgres from "postgres";
//   const conn = await postgres.connect("host=127.0.0.1 port=55432 user=postgres");
//   if (conn > 0) {
//     const res = await postgres.queryParams(conn, "select $1::int as n",
//                                            postgres.textParam("41"));
//     console.log("n:", postgres.valueByName(res, 0, "n"));
//     postgres.clear(res);
//     postgres.close(conn);
//   }
//
// Pool:
//   const pool = postgres.poolCreate("host=127.0.0.1 port=55432 user=postgres",
//                                    10, 0);
//   const res = await postgres.poolQuery(pool, "select 1 as one");
//   console.log("one:", postgres.valueByName(res, 0, "one"));
//   postgres.clear(res);
//   await postgres.poolEnd(pool);
//
// Rows are read through free functions (valueByName/value/isNull); the API
// is entirely free functions over integer handles, because class instances
// do not cross module boundaries in this compiler.
//
// This module re-exports the full public surface of the package.

import native "postgres" as pg;

import {
  connect,
  connectTo,
  close,
  status,
  isOpen,
  connectionError,
  lastError,
  serverVersion,
  conninfoString,
  escapeLiteral,
  escapeIdentifier,
  query,
  queryTimeout,
  queryParams,
  queryParamsBinary,
  queryParamsTimeout,
  prepare,
  executePrepared,
  executePreparedBinary,
  execute,
  executeParams,
} from "./client.cp3";

import {
  resultStatus,
  resultError,
  resultOk,
  resultDiag,
  resultSqlstate,
  resultSeverity,
  command,
  affected,
  rowCount,
  fieldCount,
  columnName,
  columnIndex,
  fieldOid,
  value,
  valueBinary,
  valueByName,
  valueBinaryByName,
  isNull,
  isNullByName,
  clear,
} from "./result.cp3";

import {
  textParam,
  intParam,
  realParam,
  boolParam,
  nilParam,
  pack2,
  pack3,
} from "./params.cp3";

import { conninfo, quoteConninfoField } from "./conninfo.cp3";
import { transaction } from "./client.cp3";

import {
  poolCreate,
  poolAcquire,
  poolRelease,
  poolSize,
  poolPending,
  poolQuery,
  poolQueryParams,
  poolQueryParamsBinary,
  poolExecute,
  poolExecuteParams,
  poolEnd,
} from "./pool.cp3";

import {
  CONNECTION_OK,
  CONNECTION_BAD,
  RESULT_EMPTY_QUERY,
  RESULT_COMMAND_OK,
  RESULT_TUPLES_OK,
  RESULT_FATAL_ERROR,
  RESULT_PIPELINE_SYNC,
  RESULT_PIPELINE_ABORTED,
} from "./types.cp3";

