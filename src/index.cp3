  fieldOid,
  value,
  valueBinary,
  valueByName,
  valueBinaryByName,
  isNull,
  isNullByName,
  clear,
  textParam,
  intParam,
  realParam,
  boolParam,
  nilParam,
  pack2,
  pack3,
  conninfo,
  quoteConninfoField,
  transaction,
  poolCreate,
  poolAcquire,
  poolRelease,
  poolSize,
  poolPending,
  poolQuery,
  poolQueryParams,
  poolQueryParamsBinary,
  poolExecute,
  poolExecuteParams,
  poolEnd,
  CONNECTION_OK,
  CONNECTION_BAD,
  RESULT_EMPTY_QUERY,
  RESULT_COMMAND_OK,
  RESULT_TUPLES_OK,
  RESULT_FATAL_ERROR,
  RESULT_PIPELINE_SYNC,
  RESULT_PIPELINE_ABORTED,
};

// libpq's compiled-in version, e.g. 170006 for 17.6.
export function libVersion(): number {
  return pg.cp3pg_lib_version();
}

export default {
  connect,
  connectTo,
  close,
  status,
  isOpen,
  connectionError,
  lastError,
  serverVersion,
  conninfoString,
  escapeLiteral,
