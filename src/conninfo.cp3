// conninfo.cp3 - libpq conninfo string construction with proper quoting.

// Quote one conninfo value, escaping single quotes and backslashes as
// libpq expects.
export function quoteConninfoField(value: string): string {
  let out = "'";
  for (let i = 0; i < value.length; i = i + 1) {
    const ch = value.charAt(i);
    if (ch === "\\" || ch === "'") {
      out = out + "\\";
    }
    out = out + ch;
  }
  return out + "'";
}

// Assemble a conninfo string from the common fields. Values are quoted,
// so spaces, quotes and backslashes survive. Fields are always emitted
// (empty values keep libpq defaults), matching the original conninfo().
export function conninfo(host: string, port: number, database: string,
                         user: string, password: string): string {
  return "host=" + quoteConninfoField(host) +
         " port=" + port.toString() +
         " dbname=" + quoteConninfoField(database) +
         " user=" + quoteConninfoField(user) +
         " password=" + quoteConninfoField(password);
}
